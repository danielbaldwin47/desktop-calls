# The systemd user unit `just install` installs, with @COMMAND@ filled in.
# It starts Desktop Calls with the graphical session, stops it with the
# session, and restarts it if it crashes; it then adopts any Call in progress.

[Unit]
Description=Desktop Calls: your Phone's Calls on this Desktop
Documentation=https://github.com/danielbaldwin47/desktop-calls
PartOf=graphical-session.target
After=graphical-session.target

[Service]
# Started once the control interface is on the session bus.
Type=dbus
BusName=io.github.danielbaldwin47.DesktopCalls
ExecStart=@COMMAND@ service
Restart=on-failure
RestartSec=1s
# What a run after a crash needs (the Calls in progress) is kept in
# $XDG_RUNTIME_DIR/desktop-calls-service, which systemd passes as
# RUNTIME_DIRECTORY. No build before ADR-0006 used that path, so nothing
# an older build left there can be picked up.
# It survives a crash restart and goes when the service stops. A run
# systemd didn't start keeps its own elsewhere, so the two never pick up
# each other's Calls (ADR-0006).
RuntimeDirectory=desktop-calls-service
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=restart

[Install]
WantedBy=graphical-session.target
